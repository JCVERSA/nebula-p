# ============================================================================
# Nebula — configuration
# ----------------------------------------------------------------------------
# Only the 4 keys in section 1 must be filled at install time.
# Everything else is PRE-FILLED with the code's built-in defaults: leave it
# as-is unless you know why you're changing it.
# ============================================================================

# --- 1. REQUIRED (fill these) -----------------------------------------------

# APP_URL: public URL of the panel (e.g. https://bot.example.com). Used for
# self-referential links and Host-header validation (M3): when set, requests
# with a foreign Host header are rejected.
APP_URL=""

# PANEL_TOKEN: REQUIRED for panel logins. The panel UI asks for this key once,
# exchanges it for a server-side session cookie (HttpOnly, 12h sliding), and
# never stores it in the browser. Generate one with: openssl rand -hex 32
PANEL_TOKEN=""

# GEMINI_API_KEY: Required for Gemini AI features (text, image, transcription,
# voice). Get a free key at https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=""

# OWNER_NUMBER: your WhatsApp number, international format without "+" or
# spaces (e.g. 2250700000000). Grants owner-only commands.
OWNER_NUMBER=""

# --- 2. PRE-FILLED DEFAULTS (nothing to configure) ---------------------------

# PORT: HTTP port for the panel server.
PORT=3000

# NEBULA_VF_DEFAULT: "1" (default) = VF preferred when the command doesn't say;
# "0" = VOSTFR preferred. Per-command override: `.a <q> vostfr`.
NEBULA_VF_DEFAULT="1"

# NEBULA_VOIRANIME_DISABLED: "0" (default) = voir-anime.to mirror ENABLED.
# Set "1" to park it (e.g. mirror down).
NEBULA_VOIRANIME_DISABLED="0"

# NEBULA_BATCH_CONCURRENCY: episodes downloaded in parallel per batch.
# Default/keep "1" (sequential) on small containers (~1 GB RAM).
NEBULA_BATCH_CONCURRENCY="1"

# NEBULA_BATCH_ZIP: "0" (default) = episodes delivered as separate files;
# "1" = one all-in-one ZIP archive.
NEBULA_BATCH_ZIP="0"

# NEBULA_NOVABOX_MAX_EPISODES: cap on batch episodes per request.
NEBULA_NOVABOX_MAX_EPISODES="12"

# NEBULA_NOVABOX_MAX_BATCH_MB: total size cap for one batch.
NEBULA_NOVABOX_MAX_BATCH_MB="2048"

# NEBULA_TEMP_MAX_BYTES: total bytes the temp-download storage may hold (4 GiB).
NEBULA_TEMP_MAX_BYTES="4294967296"

# NEBULA_FRANIME_ENABLED: "0" (default) = franime.fr VF path parked (needs
# FlareSolverr for the Cloudflare challenge — see section 3).
NEBULA_FRANIME_ENABLED="0"

# NEBULA_AI_DAILY_LIMIT: per-sender daily AI request budget.
NEBULA_AI_DAILY_LIMIT="40"

# NEBULA_AI_MAX_CONCURRENT: global cap on simultaneous AI requests.
NEBULA_AI_MAX_CONCURRENT="3"

# NEBULA_ENABLE_LEGACY: "false" (default) = the 145 legacy third-party command
# files stay quarantined and are never executed. Set "true" only if you
# explicitly need the old corpus.
NEBULA_ENABLE_LEGACY="false"

# NEBULA_DOWNLOAD_TIMEOUT_MS: per-download timeout (10 minutes).
NEBULA_DOWNLOAD_TIMEOUT_MS="600000"

# NEBULA_WATCH_CRON: `.a watch` scheduling (every 6 hours by default).
NEBULA_WATCH_CRON="0 */6 * * *"

# NEBULA_WATCH_QUIET: hours during which watch notifications are silenced.
NEBULA_WATCH_QUIET="23-7"

# NEBULA_PANEL_COMMANDS: "on" (default) enables panel-created commands in the
# capability-limited sandbox. Set "off" to disable the feature entirely.
NEBULA_PANEL_COMMANDS="on"

# NEBULA_ALLOW_SELF_UPDATE: "0" (default) = owner-only .update command
# disabled. Prefer a git pull + restart instead.
NEBULA_ALLOW_SELF_UPDATE="0"

# --- 3. OPTIONAL (leave commented unless needed) -----------------------------

# NEBULA_WATCH_TZ: timezone for the watch schedule/quiet hours. Unset = the
# bot's built-in default timezone.
# NEBULA_WATCH_TZ=

# DEBUG_MEDIA: verbose media-pipeline logs. LEAVE COMMENTED — the value is
# read as truthy, so even "0" would ENABLE debug output.
# DEBUG_MEDIA=

# FLARESOLVERR_URL: FlareSolverr endpoint (optional) — solves franime.fr's
# Cloudflare challenge so `.a <q> vf ...` can resolve VF player URLs from a
# datacenter IP. Start it with:
#   docker run -d --name flaresolverr -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# FLARESOLVERR_URL=http://localhost:8191/v1

# FFMPEG_BIN: explicit path to the ffmpeg binary when it is NOT on the PATH.
# (The ffmpeg-static npm package was removed — system ffmpeg is used.)
# FFMPEG_BIN=/usr/bin/ffmpeg

# NVIDIA_NIM_API_KEY: NVIDIA NIM key (nvapi-…) — AI FALLBACK engine: answers
# when the Gemini key is absent, its quota is exhausted or the API is down.
# Free key: https://build.nvidia.com/settings/api-keys
# NVIDIA_NIM_API_KEY=

# NEBULA_NIM_MODEL: NIM chat model (default meta/llama-3.3-70b-instruct).
# NEBULA_NIM_MODEL=

# NEBULA_AI_PERSONALITY: replaces the ENTIRE AI persona (system prompt) used
# by .ai and private conversations. Unset = the built-in Nebula persona
# (sober, professional, mirrors the user's language, WhatsApp formatting).
# NEBULA_AI_PERSONALITY=

# NEBULA_AI_MEMORY_TTL_HOURS: per-conversation AI memory lifetime. The counter
# restarts on every message (sliding): memory empties only after this many
# hours of SILENCE. Default 10. Set 0 to disable memory entirely.
# NEBULA_AI_MEMORY_TTL_HOURS=10

# Cross-source episode fallback (audit 8.46): when EVERY mirror of the selected
# source fails for an episode (e.g. a CDN node 403s the server), retry the same
# episode on the secondary catalog — its VF lists first, then VOSTFR. Delivered
# language is always reported honestly in the filename and message.
# 0 disables the fallback. Default: enabled.
# NEBULA_VOSTFR_FALLBACK=1

# NEBULA_AI_MEMORY_MAX_TURNS: raw turns kept per chat before compaction into
# the rolling summary (default 20, min 4, max 40).
# NEBULA_AI_MEMORY_MAX_TURNS=20

# NEBULA_JIKAN_DISABLED: "1" disables the Jikan (MyAnimeList) metadata helper.
# NEBULA_JIKAN_DISABLED="0"

# ADMIN_NUMBERS: comma-separated WhatsApp numbers granted the admin role for
# RoleGuard group policies.
# ADMIN_NUMBERS=

# NEBULA_DATA_DIR: directory for runtime state (config, access policies,
# panel commands, stats, sessions). Defaults to ./database.
# NEBULA_DATA_DIR=
