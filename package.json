{
  "name": "nebula-bot",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node --max-old-space-size=384 --expose-gc dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "lint:ts": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "anime:doctor": "tsx scripts/anime-doctor.ts"
  },
  "dependencies": {
    "@bochilteam/scraper": "^5.0.1",
    "@google/genai": "^2.4.0",
    "@hapi/boom": "^9.1.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-type": "^22.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.546.0",
    "moment-timezone": "^0.6.3",
    "motion": "^12.23.24",
    "mumaker": "^2.0.0",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "node-webpmux": "^3.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "ruhend-scraper": "^10.0.3",
    "socks-proxy-agent": "^10.1.0",
    "vite": "^6.2.3",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "redstar": {
      "minimatch": "^10.2.6"
    }
  }
}
